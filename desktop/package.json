{
  "name": "grammarquest-desktop",
  "productName": "Grammar Dialogue Quest",
  "version": "3.0.2",
  "description": "Grammar Dialogue Quest — қазақ тілі грамматикасы",
  "author": "Малышко Макар",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kz.grammarquest.desktop",
    "productName": "Grammar Dialogue Quest",
    "copyright": "Малышко Макар, 2026",
    "directories": {
      "output": "выпуск"
    },
    "files": [
      "main.cjs",
      "dist/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grammar Dialogue Quest",
      "artifactName": "GrammarDialogueQuest-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GrammarDialogueQuest-portable-${version}.${ext}"
    }
  }
}
