# Нативный проект Android хранится в репозитории — так рекомендует Capacitor,
# и так сборка не зависит от того, что происходит на машине-раннере.
# Мимо репозитория идёт только то, что генерируется заново:
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/*
!android/app/src/main/assets/.gitkeep
android/capacitor-cordova-android-plugins/build/
ios/

# Временный TTF, который make_icon.py распаковывает из woff2
resources/.golos.ttf

# Виртуальное окружение сборки презентации
презентация/venv/
презентация/__pycache__/

# venv для проверки шрифтов — ставится одной командой, в репозитории не нужен
tools/.venv/

# Материалы, присланные учителем и мамой ученика: голосовые, документы
# прошлогодней защиты, расшифровки. Репозиторий публичный — чужие файлы
# и записи частных разговоров в него не выкладываем.
олимпиада/
